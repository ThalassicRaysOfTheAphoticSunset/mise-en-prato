# Configurações do mise-en-prato
APP_MODE=dev
DATABASE_PATH=data/mise_en_prato.db
UPLOAD_DIR=uploads/recipes

# Usuário de desenvolvimento local (evita 403 nos testes)
MORADORES=dev@local.test=Dev

# Menor Preço (mantém as coordenadas padrão)
LOCAL=-25.2947,-54.0940
RAIO_KM=15
TETO_CONSULTAS_HORA=50

# Escuta para desenvolvimento local (0.0.0.0 permite acesso pelo navegador no MiguelPC)
ESCUTAR=0.0.0.0
PORTA=8090