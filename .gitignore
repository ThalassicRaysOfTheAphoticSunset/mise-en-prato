@"
# Ambientes e segredos
.env
.env.*
!.env.example

# Bancos SQLite e arquivos WAL
*.db
*.sqlite
*.sqlite3
*-wal
*-shm

# Uploads locais de fotos de receitas
uploads/
data/

# Caches de Python / Ruff / Pytest
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# Docker
.docker/
"@ | Set-Content -Encoding UTF8 .gitignore